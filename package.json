{
  "name": "pick-league",
  "private": true,
  "version": "0.1.0",
  "description": "Pick League - TikTok Live tournament bracket overlay for OBS",
  "type": "module",
  "author": "Ahmad",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node server/index.ts",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --test \"engine/**/*.test.ts\"",
    "seed": "node server/seed.ts",
    "seed:photos": "node scripts/fetch-photos.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
